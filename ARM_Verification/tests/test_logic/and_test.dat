// T04_AND : AND: toan 1, toan 0, bit xen ke (AAAA & 5555 = 0), chi mot toan hang co bit 1, AND imm, ANDS (N/Z)
// Moi dong = 1 lenh 32-bit (hex). Dong 1 vao dia chi 0x00, dong 2 vao 0x04, ...
// Sinh boi tools/gen_tests.py - co the sua tay.
E04F000F  // 0x00: SUB R0, R15, R15
E5901000  // 0x04: LDR R1, [R0, #0]
E5902004  // 0x08: LDR R2, [R0, #4]
E5903008  // 0x0C: LDR R3, [R0, #8]
E590400C  // 0x10: LDR R4, [R0, #12]
E5905010  // 0x14: LDR R5, [R0, #16]
E5906014  // 0x18: LDR R6, [R0, #20]
E0017001  // 0x1C: AND R7, R1, R1
E0018002  // 0x20: AND R8, R1, R2
E0039004  // 0x24: AND R9, R3, R4
E003A003  // 0x28: AND R10, R3, R3
E005B006  // 0x2C: AND R11, R5, R6
E001C005  // 0x30: AND R12, R1, R5
E013E004  // 0x34: ANDS R14, R3, R4
E20770FF  // 0x38: AND R7, R7, #255
E0158001  // 0x3C: ANDS R8, R5, R1
E580B018  // 0x40: STR R11, [R0, #24]
E580C01C  // 0x44: STR R12, [R0, #28]
EAFFFFFE  // 0x48: HALT
