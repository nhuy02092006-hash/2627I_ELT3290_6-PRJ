// T14_INTEGRATION_ALL7 : Tich hop du 7 lenh: ADD/SUB/AND/ORR -> STR -> LDR -> SUBS -> BEQ taken, BEQ not-taken; du lieu lenh truoc dung cho lenh sau
// Moi dong = 1 lenh 32-bit (hex). Dong 1 vao dia chi 0x00, dong 2 vao 0x04, ...
// Sinh boi tools/gen_tests.py - co the sua tay.
E04F000F  // 0x00: SUB R0, R15, R15
E2801005  // 0x04: ADD R1, R0, #5
E2802003  // 0x08: ADD R2, R0, #3
E0813002  // 0x0C: ADD R3, R1, R2
E0434002  // 0x10: SUB R4, R3, R2
E0035004  // 0x14: AND R5, R3, R4
E1836004  // 0x18: ORR R6, R3, R4
E5806020  // 0x1C: STR R6, [R0, #32]
E5907020  // 0x20: LDR R7, [R0, #32]
E0568007  // 0x24: SUBS R8, R6, R7
0A000000  // 0x28: BEQ L1
E2809063  // 0x2C: ADD R9, R0, #99
// --- nhan L1 ---
E0568001  // 0x30: SUBS R8, R6, R1
0A000000  // 0x34: BEQ L2
E2809001  // 0x38: ADD R9, R0, #1
// --- nhan L2 ---
E5809024  // 0x3C: STR R9, [R0, #36]
EAFFFFFE  // 0x40: HALT
