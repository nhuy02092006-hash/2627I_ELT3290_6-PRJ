// T11_BEQ_BACKWARD : BEQ nhay LUI (offset am, sign-extend imm24)
// Moi dong = 1 lenh 32-bit (hex). Dong 1 vao dia chi 0x00, dong 2 vao 0x04, ...
// Sinh boi tools/gen_tests.py - co the sua tay.
E04F000F  // 0x00: SUB R0, R15, R15
EA000001  // 0x04: B start
// --- nhan back ---
E280202A  // 0x08: ADD R2, R0, #42
EA000003  // 0x0C: B done
// --- nhan start ---
E0508000  // 0x10: SUBS R8, R0, R0
0AFFFFFB  // 0x14: BEQ back
E2809063  // 0x18: ADD R9, R0, #99
E2809063  // 0x1C: ADD R9, R0, #99
// --- nhan done ---
E5802000  // 0x20: STR R2, [R0, #0]
EAFFFFFE  // 0x24: HALT
