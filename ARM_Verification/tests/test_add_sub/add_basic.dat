// T01_ADD_BASIC : ADD reg/imm: toan hang 0, hai toan hang bang nhau, imm lon nhat (255), Rd khac nhau (R14, R10), ADDS ra 0 (Z=1)
// Moi dong = 1 lenh 32-bit (hex). Dong 1 vao dia chi 0x00, dong 2 vao 0x04, ...
// Sinh boi tools/gen_tests.py - co the sua tay.
E04F000F  // 0x00: SUB R0, R15, R15
E2801005  // 0x04: ADD R1, R0, #5
E2802007  // 0x08: ADD R2, R0, #7
E0813002  // 0x0C: ADD R3, R1, R2
E0834000  // 0x10: ADD R4, R3, R0
E0805000  // 0x14: ADD R5, R0, R0
E0816001  // 0x18: ADD R6, R1, R1
E28070FF  // 0x1C: ADD R7, R0, #255
E0878007  // 0x20: ADD R8, R7, R7
E288E001  // 0x24: ADD R14, R8, #1
E08EA006  // 0x28: ADD R10, R14, R6
E0909000  // 0x2C: ADDS R9, R0, R0
E289B000  // 0x30: ADD R11, R9, #0
E580E000  // 0x34: STR R14, [R0, #0]
EAFFFFFE  // 0x38: HALT
